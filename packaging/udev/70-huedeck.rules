# SPDX-License-Identifier: GPL-3.0-or-later
#
# HueDeck udev rules. Generated by `huedeck udev generate` from the plugin manifests;
# do not edit (regenerate instead).
#
# Install (once, as root), then replug the devices or trigger:
#   install -m 0644 70-huedeck.rules /etc/udev/rules.d/70-huedeck.rules
#   udevadm control --reload-rules && udevadm trigger
# Packages install it as /usr/lib/udev/rules.d/70-huedeck.rules. The number must stay
# below 73 (73-seat-late.rules applies the uaccess tag).
#
# TAG+="uaccess" gives the user of the active local seat an ACL on the node: only the
# hidraw / usb_device / tty node of a claimed VID:PID, never its input nodes.

# huedeck.evision-keyboard: EVision V2 keyboards
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5041", TAG+="uaccess"
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3299", ATTRS{idProduct}=="0012", TAG+="uaccess"

# huedeck.hid-lamparray: HID LampArray
