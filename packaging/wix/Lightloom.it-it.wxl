<!-- Lightloom installer strings, Italian (the stock dialogs come with WixToolset.UI.wixext). -->
<WixLocalization Culture="it-IT" Codepage="1252" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Language" Value="1040" />
  <String Id="Downgrade" Value="È già installata una versione più recente di Lightloom." />
  <String Id="ShortcutDescription" Value="Apri la dashboard di Lightloom" />
  <String Id="LaunchLightloom" Value="Avvia Lightloom adesso" />
  <String Id="ExitNote" Value="Se hai scelto l'illuminazione di RAM e scheda madre, dopo Fine Windows chiede l'autorizzazione una volta; una finestra mostra ogni passo." />
  <String Id="OptionsDlg_Title" Value="Installazione di [ProductName]" />
  <String Id="OptionsDlgTitle" Value="{\WixUI_Font_Title}Opzioni" />
  <String Id="OptionsDlgDescription" Value="Scegli cosa preparare con Lightloom." />
  <String Id="PawnIoCheck" Value="Illuminazione RAM e scheda madre (installa il driver PawnIO)" />
  <String Id="PawnIoText" Value="L'illuminazione di RAM e scheda madre richiede il driver PawnIO, scaricato dalla sua release ufficiale (verificata con SHA-256 e firma) e installato con una sola richiesta di autorizzazione di Windows. Senza, tutto il resto funziona; puoi aggiungerlo dopo dalle Impostazioni." />
  <String Id="AutostartCheck" Value="Avvia Lightloom all'accesso" />
  <String Id="AutostartText" Value="Lightloom resta in esecuzione in background, senza finestre." />
  <String Id="ShortcutText" Value="Un collegamento Lightloom nel menu Start apre la dashboard. Lightloom viene installato solo per te, nella tua cartella utente, senza diritti di amministratore." />
</WixLocalization>
