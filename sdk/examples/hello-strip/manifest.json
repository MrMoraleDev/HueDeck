{
  "manifestVersion": 2,
  "id": "example.hello-strip",
  "name": "Hello Strip",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "HueDeck SDK example",
  "description": "A made-up 8-LED USB HID strip (pid.codes test id 1209:0001): the plugin the SDK README builds. Not a real product.",
