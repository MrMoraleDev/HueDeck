  "conflictingProcesses": ["TT RGB Plus.exe", "TTRGBPlus.exe", "TT RGB Plus 2.0.exe", "TTRGBPLUSService.exe"],
  "keywords": ["thermaltake", "riing", "riing-quad", "riing-trio", "fan", "argb", "openrgb"]
}
