# SPDX-License-Identifier: GPL-3.0-or-later
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 110

[*.{js,mjs,cjs,ts,json,jsonc,yml,yaml,svelte,html,css}]
indent_size = 2

[*.{toml,py,wxs,rules,template,service}]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf
