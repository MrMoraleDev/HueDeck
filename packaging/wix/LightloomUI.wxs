<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!--
  The installer's dialogs: the stock WixUI dialogs (WixToolset.UI.wixext)
  in the order Welcome, Licence, Lightloom options, Ready, Progress, Finish,
  with no folder choice (a per-user install goes to
  %LOCALAPPDATA%\Programs\Lightloom).

  LightloomOptionsDlg has the two options:
    INSTALLPAWNIO  RAM and motherboard lighting (installs the PawnIO driver)
    AUTOSTART      start Lightloom at sign-in
  Pressing Finish runs RAM lighting setup when INSTALLPAWNIO is checked
  (lightloom-setup asks Windows for permission itself; a silent install never
  does) and starts Lightloom when "Start Lightloom now" is checked.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="LightloomUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="ExitDialog" />

      <!-- Finish: the optional checkbox starts Lightloom (checked by default). -->
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchLightloom)" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="!(loc.ExitNote)" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetUpRamLighting" Order="1"
               Condition="INSTALLPAWNIO = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLightloom" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg"
               Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg"
               Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="LightloomOptionsDlg"
               Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="LightloomOptionsDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="LightloomOptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="LightloomOptionsDlg" Order="1"
               Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2"
               Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2"
               Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Dialog Id="LightloomOptionsDlg" Width="370" Height="270" Title="!(loc.OptionsDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.OptionsDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="!(loc.OptionsDlgDescription)" />

        <Control Id="PawnIoCheck" Type="CheckBox" X="20" Y="56" Width="330" Height="17"
                 Property="INSTALLPAWNIO" CheckBoxValue="1" Text="!(loc.PawnIoCheck)" />
        <Control Id="PawnIoText" Type="Text" X="37" Y="74" Width="313" Height="44" NoPrefix="yes"
                 Text="!(loc.PawnIoText)" />

        <Control Id="AutostartCheck" Type="CheckBox" X="20" Y="126" Width="330" Height="17"
                 Property="AUTOSTART" CheckBoxValue="1" Text="!(loc.AutostartCheck)" />
        <Control Id="AutostartText" Type="Text" X="37" Y="144" Width="313" Height="20" NoPrefix="yes"
                 Text="!(loc.AutostartText)" />

        <Control Id="ShortcutText" Type="Text" X="20" Y="176" Width="330" Height="40" NoPrefix="yes"
                 Text="!(loc.ShortcutText)" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
