#
# Lightloom daemon - systemd *user* unit.
#
# Install:   cp lightloomd.service ~/.config/systemd/user/
#            systemctl --user daemon-reload
#            systemctl --user enable --now lightloomd
# Logs:      journalctl --user -u lightloomd -f
# Check:     systemd-analyze --user verify ~/.config/systemd/user/lightloomd.service
#
# ExecStart expects %h/.local/bin/lightloomd, normally a symlink into the unpacked release
# tarball (~/.local/lib/lightloom/lightloomd, see docs/linux-porting.md): the daemon finds
# its plugins, effects and dashboard next to the real executable, and /proc/self/exe
# resolves the symlink. The AppImage and the Flatpak print this unit with their own
# ExecStart (`Lightloom.AppImage --systemd-unit`,
# `flatpak run io.github.MrMoraleDev.Lightloom --systemd-unit`).
#
# The daemon is unprivileged. Device access comes from udev rules
# (packaging/udev/70-lightloom.rules, generated by `lightloom udev generate`): `uaccess` ACLs
# on hidraw / usb / tty nodes for the seat user and group `i2c` on the SMBus adapters,
# never from running as root. Set LIGHTLOOM_HOME (one directory) or LIGHTLOOM_CONFIG (the
# config file) to relocate state.

[Unit]
Description=Lightloom RGB manager daemon
Documentation=https://github.com/MrMoraleDev/Lightloom
# Ordering only: start after the desktop session when there is one (screen capture and
# `--open` want it), but do not require it, so headless and window-manager-only sessions
# without graphical-session.target still get lighting.
After=graphical-session.target
# Give up after 5 failed starts in a minute (a broken config, a port in use) instead of
# restarting forever; `systemctl --user reset-failed lightloomd` re-arms it.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/lightloomd
Restart=on-failure
RestartSec=2s
# The daemon handles SIGTERM by restoring device state before exiting; the renderer
# child (same cgroup) is stopped with it.
KillSignal=SIGTERM
TimeoutStopSec=10s
Environment=RUST_LOG=info
# The API token and the SQLite state are private to the user.
UMask=0077

# Hardening that works in every `systemd --user` instance. All of these are seccomp or
# prctl based and need only NoNewPrivileges, which a user manager can always set.
#
# Left out on purpose:
# - ProtectSystem=, ProtectHome=, PrivateTmp=, ReadWritePaths=, PrivateDevices=,
#   ProtectKernel*=, ProtectClock=: they need a mount namespace, which user instances
#   get only where unprivileged user namespaces are allowed; elsewhere the unit fails
#   with "Failed to set up mount namespacing". PrivateDevices= would also hide
#   /dev/hidraw* and /dev/i2c-*.
# - DeviceAllow= / DevicePolicy=: need the cgroup device controller, which is not
#   delegated to user managers (systemd ignores them there with a warning). The udev
#   rules are the device policy.
# - MemoryDenyWriteExecute=: inherited by lightloom-renderer, whose V8 JIT needs W+X pages.
# - RestrictNamespaces=, SystemCallFilter=: the Chromium sandbox in lightloom-renderer
#   creates user/pid/net namespaces and makes syscalls outside @system-service.
#
# hidraw (open/read/write/ioctl HIDIOCSFEATURE), /dev/i2c-* (ioctl I2C_RDWR / I2C_SMBUS)
# and usbfs are plain file I/O and unaffected by everything below.
NoNewPrivileges=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# AF_UNIX: renderer control socket, journald; AF_INET/AF_INET6: the 127.0.0.1 API and
# dashboard, the OpenRGB SDK server, network-device plugins (HTTP, mDNS); AF_NETLINK:
# the udev hotplug monitor.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
