#
# Lightloom udev rules - TEMPLATE.
#
# Do not install this file as is. The concrete /etc/udev/rules.d/70-lightloom.rules is
# produced by `tools/gen-udev` (or `lightloom udev generate`) from the VID:PID pairs declared
# by every loaded plugin manifest, then installed with `lightloom udev install` (sudo once).
# After installing: `sudo udevadm control --reload-rules && sudo udevadm trigger`.
#
# Two rule shapes are emitted:
#
# 1. USB / HID devices: `TAG+="uaccess"` grants the active seat user an ACL on the
#    hidraw and usb device nodes (systemd-logind), so the unprivileged daemon can open
#    them. One rule per VID:PID; the generator fills @VID@/@PID@ in lowercase hex.
#
# 2. SMBus / I2C adapters: `/dev/i2c-*` nodes go to group `i2c` (create it with
#    `groupadd -r i2c` and add the user with `usermod -aG i2c $USER`). RAM, motherboard
#    and GPU I2C plugins use these nodes directly; no privileged helper on Linux.
#
# Example of the generated output (MSI MAG B550 Tomahawk 1462:7c91):
#
#   # MSI Mystic Light (msi-mystic-light-7c91)
#   SUBSYSTEMS=="usb", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="7c91", TAG+="uaccess"
#   KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="7c91", TAG+="uaccess"
#
# ---- per-device block (repeated by the generator) ---------------------------------
# @PLUGIN_NAME@ (@PLUGIN_ID@)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="@VID@", ATTRS{idProduct}=="@PID@", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="@VID@", ATTRS{idProduct}=="@PID@", TAG+="uaccess"
# ---- end per-device block ----------------------------------------------------------

# SMBus / I2C adapters (emitted once)
KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"
