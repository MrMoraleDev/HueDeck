#
# Lightloom daemon - systemd *user* unit.
#
# Install:   cp lightloomd.service ~/.config/systemd/user/
#            systemctl --user daemon-reload
#            systemctl --user enable --now lightloomd
# Logs:      journalctl --user -u lightloomd -f
#
# The daemon is unprivileged. Device access comes from udev rules
# (packaging/udev/70-lightloom.rules.template, generated by tools/gen-udev), never from
# running as root. Set LIGHTLOOM_CONFIG / LIGHTLOOM_DATA to relocate config and SQLite state.

[Unit]
Description=Lightloom RGB manager daemon
Documentation=https://github.com/lightloom/lightloom
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/lightloomd
Restart=on-failure
RestartSec=2s
# Keep the last frame alive across short renderer hiccups; the daemon handles
# SIGTERM by restoring device state before exiting.
KillSignal=SIGTERM
TimeoutStopSec=10s
Environment=RUST_LOG=info
# Hardening (user scope; devices are reached through hidraw/i2c-dev nodes).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/lightloom %h/.local/share/lightloom %h/.cache/lightloom
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
