#
# HueDeck daemon - systemd *user* unit.
#
# Install:   cp huedeckd.service ~/.config/systemd/user/
#            systemctl --user daemon-reload
#            systemctl --user enable --now huedeckd
# Logs:      journalctl --user -u huedeckd -f
#
# The daemon is unprivileged. Device access comes from udev rules
# (packaging/udev/70-huedeck.rules.template, generated by tools/gen-udev), never from
# running as root. Set HUEDECK_CONFIG / HUEDECK_DATA to relocate config and SQLite state.

[Unit]
Description=HueDeck RGB manager daemon
Documentation=https://github.com/huedeck/huedeck
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/huedeckd
Restart=on-failure
RestartSec=2s
# Keep the last frame alive across short renderer hiccups; the daemon handles
# SIGTERM by restoring device state before exiting.
KillSignal=SIGTERM
TimeoutStopSec=10s
Environment=RUST_LOG=info
# Hardening (user scope; devices are reached through hidraw/i2c-dev nodes).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/huedeck %h/.local/share/huedeck %h/.cache/huedeck
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
